{
  "$schema": "./curves.schema.json",
  "meta": {
    "description": "5-year value-retention curves from published/cited sources. Each row: fraction of original MSRP retained at the end of years 1–5 (US market, nominal). Named-model curves are matched exactly; segment rows are the fallback when no named curve exists. Replaces the cancelled ML-training approach — no model, no dataset.",
    "powertrains": [
      "EV",
      "ICE",
      "Hybrid",
      "PHEV",
      "Diesel",
      "FCV"
    ],
    "body_classes": [
      "sedan",
      "hatchback",
      "suv",
      "truck",
      "minivan",
      "sports"
    ],
    "price_bands": [
      "budget",
      "mid",
      "premium"
    ],
    "price_band_bounds": {
      "budget_max": 35000,
      "premium_min": 60000,
      "note": "MSRP < budget_max → budget; MSRP >= premium_min → premium; otherwise mid."
    },
    "model_key_convention": "slug(make)-slug(model), e.g. \"tesla-model-3\" (lowercase, non-alphanumeric → \"-\").",
    "segment_key_convention": "seg-{powertrain-lowercase}-{body_class}-{price_band}, e.g. \"seg-ev-suv-mid\".",
    "retention_definition": "retention[i] = resale value at end of year (i+1) as a fraction of original MSRP. Must be strictly decreasing and within (0,1).",
    "filling_instructions": "For each row fill retention[y1..y5], spread_pct, source, source_year, source_url, then set status to \"ready\". Do NOT invent numbers — every ready row must cite a published source with a URL. Run `npm run validate:curves` to check; `--strict` also fails on any remaining TODO."
  },
